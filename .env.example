# Copy to .env and fill in. Do not commit real values.
# docker compose up reads this file for the api service.
# On Railway, set the same names in the service variables. See the Railway section of the README.

# Long random string. The development default is not safe to share.
OHBABY_JWT_SECRET=

# Shared by the DuckDB server container and the API. At least 4 characters.
# Letters, numbers, dots, and dashes only.
DUCKDB_QUACK_TOKEN=

# Firebase web app config (Project settings → Your apps → Web).
# Leave unset to run the feeding log without sign-in.
# Enable Authentication → Google, and add localhost, 127.0.0.1, and the
# Railway web hostname under Authorized domains.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Comma-separated browser origins allowed to call the API.
OHBABY_ALLOWED_ORIGINS=http://127.0.0.1:47219,http://localhost:47219,http://127.0.0.1:47221,http://localhost:47221
OHBABY_APP_ORIGINS=http://127.0.0.1:47219,http://localhost:47219,http://127.0.0.1:47221,http://localhost:47221

OHBABY_ADDR=:47220
OHBABY_DB=data/ohbaby.duckdb
# Set when the Go process should also serve a `flutter build web` directory.
OHBABY_WEB_ROOT=
