# Copy to .env and fill in. Do not commit real values.

# Long random string. The development default is not safe to share.
OHBABY_JWT_SECRET=

# Web application OAuth client from Google Cloud Console.
# Leave unset to run the feeding log without sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an authorized redirect URI on that OAuth client, exactly.
# Split dev servers (Flutter 47219, API 47220):
GOOGLE_REDIRECT_URI=http://127.0.0.1:47220/v1/auth/google/callback
# One process on a Mac (API + web): http://127.0.0.1:47221/v1/auth/google/callback
# Tunnel: https://YOUR_HOSTNAME/v1/auth/google/callback

# Comma-separated browser origins allowed to call the API and to return from Google.
OHBABY_ALLOWED_ORIGINS=http://127.0.0.1:47219,http://localhost:47219,http://127.0.0.1:47221,http://localhost:47221
OHBABY_APP_ORIGINS=http://127.0.0.1:47219,http://localhost:47219,http://127.0.0.1:47221,http://localhost:47221

OHBABY_ADDR=:47220
OHBABY_DB=data/ohbaby.duckdb
# Set when the Go process should also serve a `flutter build web` directory.
OHBABY_WEB_ROOT=
